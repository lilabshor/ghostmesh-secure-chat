# ------------------------------------------------------------------
# GhostMesh Secure Chat - Environment Configuration Template
# Duplicate this file to .env and adjust variables as needed.
# ------------------------------------------------------------------

# Application Environment (development / production)
APP_ENV=production
APP_DEBUG=false

# WebSocket Relay Daemon Configuration
WS_HOST=0.0.0.0
WS_PORT=9000
WS_MAX_CONN=500

# Cryptographic & Anti-Spam Parameters
POW_BITS=12
SIGNAL_TTL=300
MSG_TTL=3600

# Database Connection (MySQL 8.0+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ghostmesh_db
DB_USERNAME=ghostmesh
DB_PASSWORD=secret_password_here
DB_ROOT_PASSWORD=root_secret_password_here
